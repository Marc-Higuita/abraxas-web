# Supabase (Settings > API). La URL y la anon key son públicas; la service role NUNCA va al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Correos que pueden moderar el mural en /admin, separados por coma
ADMIN_EMAILS=
# Sal para anonimizar IPs en el rate limiting
RATE_LIMIT_SALT=cambia-esto
# Playlist de Spotify inspirada en Abraxas (URL pública de la playlist)
NEXT_PUBLIC_SPOTIFY_PLAYLIST_URL=
